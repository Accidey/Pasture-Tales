{
  "multipart": [
    {"when": {"facing": "north|south"}, "apply": {"model": "pasture-tales:block/feeding_trough_body"}},
    {"when": {"facing": "east|west"}, "apply": {"model": "pasture-tales:block/feeding_trough_body", "y": 90}},
    {"when": {"facing": "north|south", "cap_west": "true"}, "apply": {"model": "pasture-tales:block/feeding_trough_cap_west"}},
    {"when": {"facing": "north|south", "cap_east": "true"}, "apply": {"model": "pasture-tales:block/feeding_trough_cap_east"}},
    {"when": {"facing": "east|west", "cap_north": "true"}, "apply": {"model": "pasture-tales:block/feeding_trough_cap_west", "y": 90}},
    {"when": {"facing": "east|west", "cap_south": "true"}, "apply": {"model": "pasture-tales:block/feeding_trough_cap_east", "y": 90}},
    {"when": {"facing": "north|south", "level": "1"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_1"}},
    {"when": {"facing": "east|west", "level": "1"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_1", "y": 90}},
    {"when": {"facing": "north|south", "level": "2"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_2"}},
    {"when": {"facing": "east|west", "level": "2"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_2", "y": 90}},
    {"when": {"facing": "north|south", "level": "3"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_3"}},
    {"when": {"facing": "east|west", "level": "3"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_3", "y": 90}},
    {"when": {"facing": "north|south", "level": "4"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_4"}},
    {"when": {"facing": "east|west", "level": "4"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_4", "y": 90}},
    {"when": {"facing": "north|south", "level": "5"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_5"}},
    {"when": {"facing": "east|west", "level": "5"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_5", "y": 90}},
    {"when": {"facing": "north|south", "level": "6"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_6"}},
    {"when": {"facing": "east|west", "level": "6"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_6", "y": 90}},
    {"when": {"facing": "north|south", "level": "7"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_7"}},
    {"when": {"facing": "east|west", "level": "7"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_7", "y": 90}},
    {"when": {"facing": "north|south", "level": "8"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_8"}},
    {"when": {"facing": "east|west", "level": "8"}, "apply": {"model": "pasture-tales:block/feeding_trough_feed_8", "y": 90}}
  ]
}
